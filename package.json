{
  "name": "calorieout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nutrition & calorie explorer for Canadian restaurants",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "menus:validate": "esbuild scripts/menus/validate.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/menus/validate.mjs --log-level=error && node node_modules/.cache/menus/validate.mjs",
    "menus:mcdonalds": "node scripts/menus/gen-mcdonalds.cjs",
    "menus:timhortons": "node scripts/menus/fetch-timhortons.cjs && esbuild scripts/menus/gen-timhortons.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/menus/gen-timhortons.mjs --log-level=error && node node_modules/.cache/menus/gen-timhortons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
