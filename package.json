{
  "name": "calorieout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nutrition & calorie explorer for Canadian restaurants",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "menus:validate": "node scripts/menus/run.cjs validate.ts",
    "menus:mcdonalds": "node scripts/menus/gen-mcdonalds.cjs",
    "menus:timhortons": "node scripts/menus/fetch-rbi.cjs timhortons && node scripts/menus/run.cjs gen-rbi.ts timhortons",
    "menus:burgerking": "node scripts/menus/fetch-rbi.cjs burgerking && node scripts/menus/run.cjs gen-rbi.ts burgerking",
    "menus:aw": "node scripts/menus/fetch-aw.cjs && node scripts/menus/run.cjs gen-aw.ts",
    "menus:harveys": "node scripts/menus/run.cjs gen-harveys.ts",
    "menus:wendys": "node scripts/menus/fetch-wendys.cjs && node scripts/menus/run.cjs gen-wendys.ts",
    "menus:kfc": "node scripts/menus/fetch-kfc.cjs && node scripts/menus/run.cjs gen-kfc.ts",
    "menus:dq": "node scripts/menus/run.cjs gen-dq.ts",
    "menus:firehouse": "node scripts/menus/fetch-rbi.cjs firehouse && node scripts/menus/run.cjs gen-rbi.ts firehouse",
    "menus:littlecaesars": "node scripts/menus/run.cjs gen-littlecaesars.ts",
    "menus:marybrowns": "node scripts/menus/fetch-marybrowns.cjs && node scripts/menus/run.cjs gen-marybrowns.ts",
    "menus:pizzahut": "node scripts/menus/fetch-pizzahut.cjs && node scripts/menus/run.cjs gen-pizzahut.ts",
    "menus:thaiexpress": "node scripts/menus/fetch-thaiexpress.cjs && node scripts/menus/run.cjs gen-thaiexpress.ts",
    "menus:manchuwok": "node scripts/menus/fetch-manchuwok.cjs && node scripts/menus/run.cjs gen-manchuwok.ts",
    "menus:osmows": "node scripts/menus/fetch-osmows.cjs && node scripts/menus/run.cjs gen-osmows.ts",
    "menus:subway": "node scripts/menus/fetch-subway.cjs && node scripts/menus/run.cjs gen-subway.ts",
    "menus:pitapit": "node scripts/menus/fetch-pitapit.cjs && node scripts/menus/run.cjs gen-pitapit.ts",
    "menus:muchoburrito": "node scripts/menus/fetch-muchoburrito.cjs && node scripts/menus/run.cjs gen-muchoburrito.ts",
    "menus:tahinis": "node scripts/menus/run.cjs gen-tahinis.ts",
    "menus:works": "node scripts/menus/fetch-works.cjs && node scripts/menus/run.cjs gen-works.ts",
    "menus:swisschalet": "node scripts/menus/run.cjs gen-swisschalet.ts",
    "menus:bostonpizza": "node scripts/menus/fetch-bostonpizza.cjs && node scripts/menus/run.cjs gen-bostonpizza.ts",
    "menus:barburrito": "node scripts/menus/fetch-barburrito.cjs && node scripts/menus/run.cjs gen-barburrito.ts",
    "menus:freshii": "node scripts/menus/fetch-freshii.cjs && node scripts/menus/run.cjs gen-freshii.ts",
    "menus:tacobell": "node scripts/menus/fetch-tacobell.cjs && node scripts/menus/run.cjs gen-tacobell.ts",
    "menus:starbucks": "node scripts/menus/fetch-starbucks.cjs && node scripts/menus/run.cjs gen-starbucks.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
